#!/usr/bin/env bash
# CPU temperature and memory in use.
# Left click: btop. Right click: CPU usage and fan speed.

SENSORS=$(sensors 2>/dev/null)   # run once, reuse below

# CPU package temperature (Intel), with fallbacks for other chips
CPU_TEMP=$(awk '
    /^Package id 0:|^Tdie:|^Tctl:|^Core 0:|^CPU:/ {
        for (i = 2; i <= NF; i++) {
            t = $i; gsub(/[+°C]/, "", t)
            if (t ~ /^[0-9]+(\.[0-9]+)?$/) { sub(/\..*/, "", t); print t; exit }
        }
    }' <<<"$SENSORS")
[ -z "$CPU_TEMP" ] && CPU_TEMP="N/A"

FAN_SPEED=$(awk '/^fan[0-9]*:|^cpu_fan:/ {print $2 " " $3; exit}' <<<"$SENSORS")
[ -z "$FAN_SPEED" ] && FAN_SPEED="N/A"

MEM_USE=$(free -m | awk '/^Mem/ {printf "%.1f", $3/1024}')

# Icon and colour by temperature
if [ "$CPU_TEMP" = "N/A" ]; then
  COLOR="#d8dee9"; CPU_ICON="󰍛 ?"
elif [ "$CPU_TEMP" -gt 75 ]; then
  COLOR="#bf616a"; CPU_ICON=""    # hot
elif [ "$CPU_TEMP" -gt 65 ]; then
  COLOR="#ebcb8b"; CPU_ICON="󰍛"    # warm
else
  COLOR="#a3be8c"; CPU_ICON="󰍛"
fi

case $BLOCK_BUTTON in
1) setsid -f "${TERMINAL:-st}" -e btop ;;
3) CPU_USE=$(iostat -c | awk '/avg-cpu:/ {getline; printf "User CPU: %s%%\nSystem CPU: %s%%", $1, $3}')
   notify-send -t 10000 -h string:bgcolor:$COLOR "Stats" "$CPU_USE
CPU temp: ${CPU_TEMP}°C
Fan speed: $FAN_SPEED" ;;
6) setsid -f "${TERMINAL:-st}" -e "${EDITOR:-nvim}" "$0" ;;
esac

echo "$CPU_ICON ${CPU_TEMP}°C   ${MEM_USE}g"
