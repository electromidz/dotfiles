#!/bin/sh
# Speaker volume and microphone state, e.g. "󰕾 80% 󰍬".
# Left click: mixer. Right click: mute speakers. Middle click: mute mic.
# Scroll: volume up / down.

case $BLOCK_BUTTON in
1) if command -v pavucontrol >/dev/null; then setsid -f pavucontrol
   else setsid -f "${TERMINAL:-st}" -e wiremix; fi ;;
2) wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle ;;
3) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
4) wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+ ;;
5) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
6) setsid -f "${TERMINAL:-st}" -e "${EDITOR:-nvim}" "$0" ;;
esac

# "Volume: 0.80" or "Volume: 0.80 [MUTED]"
spk=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)
mic=$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null)

vol=$(echo "$spk" | awk '{printf "%d", $2 * 100 + 0.5}')
case "$spk" in
*MUTED*) icon="󰝟" ;;                       # md-volume_mute
*) if   [ "$vol" -ge 60 ]; then icon="󰕾"   # md-volume_high
   elif [ "$vol" -ge 25 ]; then icon="󰖀"   # md-volume_medium
   else icon="󰕿"; fi ;;                    # md-volume_low
esac

case "$mic" in
"") micicon="" ;;                          # no microphone found
*MUTED*) micicon=" 󰍭" ;;                   # md-microphone_off
*) micicon=" 󰍬" ;;                         # md-microphone
esac

echo "$icon ${vol}%${micicon}"
